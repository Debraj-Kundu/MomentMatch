# ---------------------------------------------------------------
# Grabpic monorepo
# Subprojects keep their own .gitignore files; this file covers the
# root and anything that would otherwise slip through.
# ---------------------------------------------------------------

# Secrets / local env
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp

# Logs
*.log
logs/

# ---- Java / Spring Boot (grabpic/) ----
grabpic/target/
grabpic/.mvn/wrapper/maven-wrapper.jar
grabpic/HELP.md
build/

# ---- Next.js (grabpic-client/) ----
node_modules/
grabpic-client/.next/
grabpic-client/out/
grabpic-client/coverage/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# ---- Python (image-processor/) ----
__pycache__/
*.py[cod]
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
*.egg-info/
# downloaded model weights / caches (InsightFace, HuggingFace CLIP)
.insightface/
.cache/
*.onnx

# ---- Infra (local-only) ----
infra/self/
infra/nginx/

# ---- Local data, docs & AI agent context ----
/data/
PROJECT_CONTEXT.md
**/CLAUDE.md
**/CLAUDE.local.md
**/AGENTS.md
**/AGENT.md
**/.claude/
