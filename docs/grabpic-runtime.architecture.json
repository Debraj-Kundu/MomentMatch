  "cards": [
    {
      "dot": "cyan",
      "title": "Primary Paths",
      "items": [
        "Upload: browser PUTs to a presigned MinIO URL; the bucket webhook marks media READY",
        "Index: API posts /process-album; a worker embeds faces and images into Qdrant",
        "Ask: /match-face or /find-similar returns 202; the result webhook is saved and pushed over STOMP"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries",
      "items": [
        "The JWT lives server-side in the next-auth session; the BFF adds it as a Bearer header",
        "/ws checks the Bearer token in STOMP CONNECT, not in the HTTP handshake",
        "/api/v1/webhooks/** and /api/v1/redis/** are permitAll with no signature check",
        "The AI plane, Redis, Qdrant and MinIO trust the network; they use default credentials"
      ]
    },
    {
      "dot": "amber",
      "title": "Supporting Detail",
      "items": [
        "Schedulers run every minute to reconcile upload status via MinIO object metadata",
        "Read URLs are MinIO presigned GETs; the Nginx HMAC CDN in infra/ is configured but not wired",
        "Workers skip media that fail, and album-level failure webhooks are still TODO"
      ]
    }
  ]
